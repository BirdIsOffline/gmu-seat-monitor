# Never publish phone notification keys or per-run local state
bark_key.txt
ntfy_topic.txt
seat_state.json
seat_state.tmp
.env
*.env
__pycache__/
*.pyc
.venv/
# Local historical data and SQLite journals/backups must never be published.
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
# Historical outbox owner locks (never unlink one while a process holds it).
*.db.lock
*.sqlite.lock
*.sqlite3.lock
# Offline Cloudflare tooling, local bindings, and secrets
node_modules/
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
