# Never publish phone notification keys or per-run local state
bark_key.txt
ntfy_topic.txt
seat_state.json
seat_state.tmp
.env
*.env
__pycache__/
*.pyc
.venv/
# Local historical data and SQLite journals/backups must never be published.
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
# Replay databases retain the original SQLite extension.
*.db.replay
*.sqlite.replay
*.sqlite3.replay
# SQLite backups and owner locks, including replay/backup filename variants.
# Match data suffixes explicitly so files such as schema.db.sql stay visible.
*.db*.bak
*.sqlite*.bak
*.db*.backup
*.sqlite*.backup
*.db*.lock
*.sqlite*.lock
# SQLite sidecars also follow replay and backup filenames.
*.db*-journal
*.db*-wal
*.db*-shm
*.sqlite*-journal
*.sqlite*-wal
*.sqlite*-shm
# Optional canonical payload export from the recovery example, at repo root.
/prepared.json
# Offline Cloudflare tooling, local bindings, and secrets
node_modules/
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
